+// Copia este archivo como  include/comm_secrets.h  y rellenalo.
+// comm_secrets.h esta en .gitignore: NUNCA lo subas al repositorio (el repo es publico).
+#ifndef COMM_SECRETS_H
+#define COMM_SECRETS_H
+
+#define COMM_WIFI_SSID   "nombre-de-tu-wifi"
+#define COMM_WIFI_PASS   "clave-de-tu-wifi"
+
+// Servidor de ThingsBoard. En ThingsBoard Cloud: mqtt.thingsboard.cloud
+#define COMM_TB_HOST     "mqtt.thingsboard.cloud"
+#define COMM_TB_PORT     8883
+// Token de acceso del dispositivo "pulsera" (Device -> Copy access token)
+#define COMM_TB_TOKEN    "pega-aqui-el-token"
+
+// Hora local: Ecuador = UTC-5 = -300 minutos
+#define COMM_UTC_OFFSET_MIN  (-300)
+
+// (Opcional, recomendado) certificado de la CA del servidor, en formato PEM,
+// para verificar que el servidor es el verdadero. Sin esto la conexion va cifrada
+// pero NO se verifica la identidad del servidor (aceptable solo para pruebas).
+// #define COMM_TB_CA_CERT "-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----\n"
+
+#endif
diff --git a/firmware/cogni-desk/lib/comm_core/comm_core.c b/firmware/cogni-desk/lib/comm_core/comm_core.c
new file mode 100644
index 0000000..b7a7b36
--- /dev/null
+++ b/firmware/cogni-desk/lib/comm_core/comm_core.c
@@ -0,0 +1,182 @@
+#include "comm_core.h"
+
+#include <stdio.h>
+#include <string.h>
+
+#include "alba_thingsboard.h"
+
+/* ---- cola de salida --------------------------------------------------------- */
+
+static void outbox_remove_at(comm_core_t *c, size_t i)
+{
+    for (size_t k = i; k + 1u < c->out_count; k++) c->outbox[k] = c->outbox[k + 1u];
+    c->out_count--;
+}
+
+static void outbox_push(comm_core_t *c, const char *json, bool is_event)
+{
+    if (c->out_count == COMM_OUTBOX_CAP) {
+        /* Llena: se pierde primero la telemetria mas antigua; solo si todo son
+         * alertas se pierde la alerta mas antigua. */
+        size_t victim = 0u;
+        for (size_t i = 0; i < c->out_count; i++) {
+            if (!c->outbox[i].is_event) { victim = i; break; }
+        }
+        outbox_remove_at(c, victim);
+        c->out_dropped++;
+    }
+    comm_msg_t *m = &c->outbox[c->out_count++];
+    strncpy(m->json, json, COMM_JSON_MAX - 1u);
+    m->json[COMM_JSON_MAX - 1u] = '\0';
+    m->is_event = is_event;
+}
+
+bool comm_core_push_raw(comm_core_t *c, const char *json, bool is_event)
+{
+    if (json == NULL || json[0] != '{' || strlen(json) >= COMM_JSON_MAX) return false;
+    outbox_push(c, json, is_event);
+    return true;
+}
+
+const char *comm_core_outbox_peek(const comm_core_t *c)
+{
+    return c->out_count ? c->outbox[0].json : NULL;
+}
+
+void comm_core_outbox_pop(comm_core_t *c)
+{
+    if (c->out_count) outbox_remove_at(c, 0u);
+}
+
+size_t comm_core_outbox_count(const comm_core_t *c) { return c->out_count; }
+
+/* ---- envio a la pulsera ------------------------------------------------------ */
+
+static void send_to_band(comm_core_t *c, const void *pkt, size_t len)
+{
+    if (c->send == NULL || !c->send((const uint8_t *)pkt, len, c->send_ctx)) c->send_fail++;
+}
+
+static void apply_action(comm_core_t *c, robot_action_t a, uint16_t ref_seq)
+{
+    switch (a) {
+    case ROBOT_ACT_SHOW_PROMPT:
+        c->prompt_active = true;
+        break;
+    case ROBOT_ACT_HIDE_PROMPT:
+        c->prompt_active = false;
+        break;
+    case ROBOT_ACT_SHOW_HELP_CALLED:
+        c->prompt_active = false;
+        c->help_called = true;
+        break;
+    case ROBOT_ACT_SEND_CANCEL: {
+        alba_cancel_t m;
+        alba_pack_cancel(&m, c->tx_seq++, ref_seq);
+        send_to_band(c, &m, sizeof m);
+        c->prompt_active = false;
+        break;
+    }
+    case ROBOT_ACT_NONE:
+    default:
+        break;
+    }
+}
+
+/* ---- API ----------------------------------------------------------------------- */
+
+void comm_core_init(comm_core_t *c, comm_send_fn send, void *send_ctx)
+{
+    memset(c, 0, sizeof *c);
+    robot_link_init(&c->link);
+    robot_fall_init(&c->fall);
+    c->send = send;
+    c->send_ctx = send_ctx;
+}
+
+void comm_core_on_packet(comm_core_t *c, const uint8_t *buf, size_t len,
+                         uint32_t now_ms, uint64_t epoch_ms)
+{
+    robot_rx_msg_t m;
+    if (robot_link_on_packet(&c->link, buf, len, now_ms, &m) != ROBOT_RX_NEW) return;
+
+    c->seen_band = true;
+    c->last_rx_ms = now_ms;
+
+    char json[COMM_JSON_MAX];
+    if (m.type == ALBA_MSG_TELEMETRIA) {
+        c->have_vitals = true;
+        c->bpm = m.tel.bpm;
+        c->spo2 = m.tel.spo2;
+        c->bat = m.tel.bateria_pct;
+        c->vitals_ms = now_ms;
+        if (alba_telemetry_to_tb(&m.tel, epoch_ms, json, sizeof json) > 0) outbox_push(c, json, false);
+    } else if (m.type == ALBA_MSG_EVENTO) {
+        if (alba_event_to_tb(&m.evt, epoch_ms, json, sizeof json) > 0) outbox_push(c, json, true);
+        uint16_t ref = 0;
+        const robot_action_t a = robot_fall_on_event(&c->fall, &m.evt, now_ms, &ref);
+        apply_action(c, a, ref);
+    }
+}
+
+void comm_core_button_ok(comm_core_t *c, uint32_t now_ms)
+{
+    uint16_t ref = 0;
+    const robot_action_t a = robot_fall_on_button_ok(&c->fall, now_ms, &ref);
+    apply_action(c, a, ref);
+}
+
+void comm_core_tick(comm_core_t *c, uint32_t now_ms, uint32_t epoch_s, int16_t utc_offset_min)
+{
+    uint16_t ref = 0;
+    apply_action(c, robot_fall_tick(&c->fall, now_ms, &ref), ref);
+
+    if (epoch_s >= ALBA_EPOCH_MIN_S && robot_link_need_time(&c->link, now_ms)) {
+        alba_time_t h;
+        alba_pack_time(&h, c->tx_seq++, epoch_s, utc_offset_min);
+        send_to_band(c, &h, sizeof h);
+        robot_link_time_sent(&c->link, now_ms);   /* se marca aunque falle: reintenta por la rafaga/6 h */
+    }
+}
+
+void comm_core_push_env(comm_core_t *c, uint64_t epoch_ms, int16_t temp_c_x10, uint8_t hum_pct)
+{
+    char vals[64];
+    size_t n = 0;
+    vals[0] = '\0';
+    int w;
+    if (temp_c_x10 != COMM_ENV_INVALID_TEMP) {
+        const int16_t a = (int16_t)(temp_c_x10 < 0 ? -temp_c_x10 : temp_c_x10);
+        w = snprintf(vals + n, sizeof vals - n, "\"room_temp\":%s%d.%d",
+                     temp_c_x10 < 0 ? "-" : "", a / 10, a % 10);
+        if (w < 0 || (size_t)w >= sizeof vals - n) return;
+        n += (size_t)w;
+    }
+    if (hum_pct != COMM_ENV_INVALID_HUM && hum_pct <= 100u) {
+        w = snprintf(vals + n, sizeof vals - n, "%s\"room_hum\":%u", n ? "," : "", (unsigned)hum_pct);
+        if (w < 0 || (size_t)w >= sizeof vals - n) return;
+        n += (size_t)w;
+    }
+    if (n == 0u) return;
+
+    char json[COMM_JSON_MAX];
+    char ts_s[40];
+    ts_s[0] = '\0';
+    if (epoch_ms != 0u) snprintf(ts_s, sizeof ts_s, "\"ts\":%llu,", (unsigned long long)epoch_ms);
+    w = snprintf(json, sizeof json, "{%s\"values\":{%s}}", ts_s, vals);
+    if (w > 0 && (size_t)w < sizeof json) outbox_push(c, json, false);
+}
+
+bool comm_core_prompt_active(const comm_core_t *c) { return c->prompt_active; }
+
+bool comm_core_take_help_called(comm_core_t *c)
+{
+    const bool v = c->help_called;
+    c->help_called = false;
+    return v;
+}
+
+bool comm_core_band_online(const comm_core_t *c, uint32_t now_ms)
+{
+    return c->seen_band && (uint32_t)(now_ms - c->last_rx_ms) < COMM_BAND_OFFLINE_MS;
+}
diff --git a/firmware/cogni-desk/lib/comm_core/comm_core.h b/firmware/cogni-desk/lib/comm_core/comm_core.h
new file mode 100644
index 0000000..395bdc7
--- /dev/null
+++ b/firmware/cogni-desk/lib/comm_core/comm_core.h
@@ -0,0 +1,101 @@
+/**
+ * comm_core.h
+ * Cerebro de las comunicaciones del ROBOT (cogni-desk). Une:
+ *   robot_link  (valida paquetes de la pulsera, duplicados, cuando mandar la HORA)
+ *   robot_fall  (el asistente "¿Estas bien?" y la cancelacion de caidas)
+ *   alba_thingsboard.h (JSON para ThingsBoard)
+ * y agrega una COLA DE SALIDA para la nube: si no hay WiFi/MQTT, los mensajes
+ * esperan (las alertas tienen prioridad sobre la telemetria).
+ *
+ * C puro, sin WiFi, ESP-NOW ni Arduino: se prueba en el PC (pio test -e native).
+ * CommManager.cpp es la capa delgada que lo conecta con el hardware.
+ *
+ * No es thread-safe: llamarlo siempre desde la misma tarea (el loop()). El
+ * callback de ESP-NOW NO debe llamarlo: debe copiar el paquete a una cola y
+ * dejar que el loop() lo entregue (ver CommManager.cpp).
+ */
+#ifndef COMM_CORE_H
+#define COMM_CORE_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#include "robot_fall.h"
+#include "robot_link.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define COMM_OUTBOX_CAP        16u    /* mensajes esperando para la nube        */
+#define COMM_JSON_MAX          200u   /* tamano maximo de un mensaje JSON       */
+#define COMM_BAND_OFFLINE_MS   (120u * 1000u)  /* sin paquetes en este tiempo = pulsera desconectada */
+#define COMM_ENV_INVALID_TEMP  INT16_MIN
+#define COMM_ENV_INVALID_HUM   0xFFu
+
+/** Manda bytes a la pulsera (ESP-NOW). true = aceptado por la radio. */
+typedef bool (*comm_send_fn)(const uint8_t *buf, size_t len, void *ctx);
+
+typedef struct {
+    char json[COMM_JSON_MAX];
+    bool is_event;                 /* las alertas no se descartan antes que la telemetria */
+} comm_msg_t;
+
+typedef struct {
+    robot_link_t link;
+    robot_fall_t fall;
+    comm_send_fn send;
+    void        *send_ctx;
+    uint16_t     tx_seq;           /* numero de secuencia de lo que el ROBOT envia */
+
+    comm_msg_t   outbox[COMM_OUTBOX_CAP];
+    size_t       out_count;
+    uint32_t     out_dropped;      /* mensajes descartados por cola llena */
+
+    /* lo que la interfaz (pantallas) necesita saber */
+    bool     prompt_active;        /* mostrar "¿Estas bien?" y atender el boton */
+    bool     help_called;          /* la caida se confirmo: avisar al paciente (se consume) */
+    bool     have_vitals;
+    uint8_t  bpm, spo2, bat;       /* ultimo valor recibido (invalidos = ver alba_protocol.h) */
+    uint32_t vitals_ms;            /* cuando llego el ultimo dato de la pulsera */
+    uint32_t last_rx_ms;
+    bool     seen_band;
+    uint32_t send_fail;            /* envios a la pulsera que la radio rechazo */
+} comm_core_t;
+
+void comm_core_init(comm_core_t *c, comm_send_fn send, void *send_ctx);
+
+/** Un paquete llego de la pulsera. epoch_ms = hora real en ms Unix (0 si el robot no la sabe). */
+void comm_core_on_packet(comm_core_t *c, const uint8_t *buf, size_t len,
+                         uint32_t now_ms, uint64_t epoch_ms);
+
+/** El paciente pulso "estoy bien". */
+void comm_core_button_ok(comm_core_t *c, uint32_t now_ms);
+
+/** Llamar cada ~100 ms. epoch_s = hora real en segundos Unix (0 si no se sabe); con
+ *  hora invalida NO se manda HORA a la pulsera. utc_offset_min: Ecuador = -300. */
+void comm_core_tick(comm_core_t *c, uint32_t now_ms, uint32_t epoch_s, int16_t utc_offset_min);
+
+/** Datos del propio robot (sensor del cuarto) para la nube. Valores invalidos se omiten. */
+void comm_core_push_env(comm_core_t *c, uint64_t epoch_ms, int16_t temp_c_x10, uint8_t hum_pct);
+
+/** Mensaje propio ya formateado para la nube (p. ej. "se tomo la pastilla"). Debe ser JSON de ThingsBoard. */
+bool comm_core_push_raw(comm_core_t *c, const char *json, bool is_event);
+
+/* --- cola hacia la nube: leer el mas antiguo, publicar y SOLO si se envio, quitarlo --- */
+const char *comm_core_outbox_peek(const comm_core_t *c);
+void        comm_core_outbox_pop(comm_core_t *c);
+size_t      comm_core_outbox_count(const comm_core_t *c);
+
+/* --- consultas para la interfaz --- */
+bool comm_core_prompt_active(const comm_core_t *c);
+/** true UNA vez cuando la caida se confirmo (luego se borra). */
+bool comm_core_take_help_called(comm_core_t *c);
+bool comm_core_band_online(const comm_core_t *c, uint32_t now_ms);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* COMM_CORE_H */
